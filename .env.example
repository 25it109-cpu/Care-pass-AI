# CARE-PASS AI Configuration
PORT=5000
NODE_ENV=development

# Optional AI API Key (Gemini or OpenAI). If omitted, CARE-PASS AI uses its intelligent built-in multilingual extraction engine!
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Supabase Database & Auth Configuration
# If omitted, CARE-PASS AI uses its secure, instant in-memory & local fallback database
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Emergency Service Number (Configurable for local region, e.g. 108 for India, 911 for US, 112 for EU, 999 for UK)
VITE_DEFAULT_EMERGENCY_NUMBER=108
EMERGENCY_NUMBER=108
